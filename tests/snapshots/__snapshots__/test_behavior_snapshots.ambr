          'OUTSIDE_HOURS',
          'INVALID_ARGS',
          'NOT_FOUND',
          'IDENTITY_REQUIRED',
          'IDENTITY_MISMATCH',
        ]),
        'title': 'WriteRejectionReason',
        'type': 'string',
      }),
