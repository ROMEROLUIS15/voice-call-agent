# name: test_agent_tools
  dict({
    'check_availability': dict({
      'description': 'Free start times of one day for one service, and whether the time the caller asked for is free. Call it before offering or accepting a time.',
      'name': 'check_availability',
      'parameters': dict({
        'properties': dict({
          'day': dict({
            'description': 'The day, as YYYY-MM-DD.',
            'format': 'date',
            'type': 'string',
          }),
          'service_id': dict({
            'description': "The service's id, from the brackets in the service list.",
            'type': 'string',
          }),
          'start': dict({
            'anyOf': list([
              dict({
                'pattern': '^([01][0-9]|2[0-3]):[0-5][0-9]$',
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'The time the caller asked for, as HH:MM, if they named one.',
          }),
        }),
        'required': list([
          'service_id',
          'day',
        ]),
        'type': 'object',
      }),
    }),
    'confirm_booking': dict({
      'description': 'Book a proposal, only after the caller accepted it unchanged. Report the real result.',
      'name': 'confirm_booking',
      'parameters': dict({
        'properties': dict({
          'proposal_id': dict({
            'description': 'The proposal_id that propose_booking returned, once the caller accepted it.',
            'format': 'uuid',
            'type': 'string',
          }),
        }),
        'required': list([
          'proposal_id',
        ]),
        'type': 'object',
      }),
    }),
    'propose_booking': dict({
      'description': 'Propose a booking once the service, day, time and name are known. Read the summary it returns to the caller and ask whether they confirm it.',
      'name': 'propose_booking',
      'parameters': dict({
        'properties': dict({
          'client_name': dict({
            'description': 'The name the appointment is booked under.',
            'maxLength': 120,
            'minLength': 1,
            'type': 'string',
          }),
          'day': dict({
            'description': 'The day, as YYYY-MM-DD.',
            'format': 'date',
            'type': 'string',
          }),
          'service_id': dict({
            'description': "The service's id, from the brackets in the service list.",
            'type': 'string',
          }),
          'start': dict({
            'description': 'The start time, as HH:MM in 24-hour time.',
            'pattern': '^([01][0-9]|2[0-3]):[0-5][0-9]$',
            'type': 'string',
          }),
        }),
        'required': list([
          'service_id',
          'day',
          'start',
          'client_name',
        ]),
        'type': 'object',
      }),
    }),
  })
