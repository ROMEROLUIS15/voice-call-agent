# name: test_port_schema[WriteResult]
  dict({
    '$defs': dict({
      'WriteRejected': dict({
        'additionalProperties': False,
        'properties': dict({
          'kind': dict({
            'const': 'rejected',
            'default': 'rejected',
            'title': 'Kind',
            'type': 'string',
          }),
          'reason': dict({
            '$ref': '#/$defs/WriteRejectionReason',
          }),
        }),
        'required': list([
          'reason',
        ]),
        'title': 'WriteRejected',
        'type': 'object',
      }),
      'WriteRejectionReason': dict({
        'enum': list([
          'SLOT_CONFLICT',
          'OUTSIDE_HOURS',
          'INVALID_ARGS',
          'NOT_FOUND',
          'IDENTITY_REQUIRED',
          'IDENTITY_MISMATCH',
        ]),
        'title': 'WriteRejectionReason',
        'type': 'string',
      }),
      'WriteSucceeded': dict({
        'additionalProperties': False,
        'properties': dict({
          'appointment_id': dict({
            'title': 'Appointment Id',
            'type': 'string',
          }),
          'kind': dict({
            'const': 'succeeded',
            'default': 'succeeded',
            'title': 'Kind',
            'type': 'string',
          }),
        }),
        'required': list([
          'appointment_id',
        ]),
        'title': 'WriteSucceeded',
        'type': 'object',
      }),
    }),
    'anyOf': list([
      dict({
        '$ref': '#/$defs/WriteSucceeded',
      }),
      dict({
        '$ref': '#/$defs/WriteRejected',
      }),
    ]),
  })
