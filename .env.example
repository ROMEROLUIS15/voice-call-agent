# Copy to `.env` and fill in. Never commit `.env`.
# An entry (phone line / WhatsApp) is enabled only when its group is complete;
# a partially filled group stops the service at startup.

# --- HTTP server
HOST=127.0.0.1
PORT=8000

# --- Speech: Deepgram (Flux STT + Aura-2 TTS)
DEEPGRAM_API_KEY=
# Non-English speech needs Flux's multilingual model.
STT_MODEL=flux-general-multi
# Latin American Spanish voices: aura-2-selena-es, aura-2-aquila-es; Colombian: aura-2-celeste-es.
TTS_VOICE=aura-2-selena-es

# --- Language model (phase 0: chosen by measuring). One of: openrouter | groq | google | openai
# openrouter (the default): openai/gpt-oss-120b served by Groq, or by Cerebras when Groq fails,
# while Groq's developer tier is closed (manifest §7, §10). groq: the same model on Groq directly.
LLM_PROVIDER=openrouter
# Empty = the provider's default model: for OpenRouter and Groq, openai/gpt-oss-120b with reasoning
# effort low, the configuration measured in phase 0; another model keeps its provider's default
# effort.
LLM_MODEL=
# Bound of each LLM request (connect, read, write), in seconds. At most one retry.
LLM_REQUEST_TIMEOUT_SECONDS=10
# Only the selected provider's key is required.
GROQ_API_KEY=
# OpenRouter: the default provider (Groq, then Cerebras; never another, and neither collecting
# the data), also from networks that Groq refuses (manifest §10). Also the key of the judge model of the model evals (Google's, through OpenRouter; evals/,
# docs/evals/golden-dataset.md), which read LLM_PROVIDER, LLM_MODEL, LLM_REQUEST_TIMEOUT_SECONDS
# and these keys:
#   uv run --env-file .env --group evals python -m evals.model_evals
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Phone-line entry: Twilio Media Streams (all three, or none)
# Exact public URL Twilio calls (ngrok/cloudflared in development). Twilio signs webhooks with it.
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Wait for the Media Stream `start` event after the WebSocket opens, in seconds.
TWILIO_HANDSHAKE_TIMEOUT_SECONDS=5
# Timeout of each Twilio REST request (ending a call), in seconds.
TWILIO_API_TIMEOUT_SECONDS=5

# --- WhatsApp entry: Cloud API Calling (all four, or none)
# Paused: leave empty until Meta enables Calling on the number (manifest §10).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret: validates X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
# Token you choose; Meta echoes it when subscribing the webhook.
WHATSAPP_VERIFY_TOKEN=
# Timeout of each Graph API request (pre-accept, accept, reject, terminate), in seconds.
WHATSAPP_GRAPH_API_TIMEOUT_SECONDS=5

# --- Browser practice entry (development only, ADR 0015)
# true: http://localhost:8000/practice talks to the agent through this computer's microphone.
# Needs ENVIRONMENT=development; only a browser on this machine can start a call.
# The defaults in this file are for deployment. To practice locally, set in `.env`:
#   ENVIRONMENT=development
#   BROWSER_PRACTICE_ENABLED=true
#   SCHEDULING_BACKEND=practice
#   LOG_FORMAT=text
BROWSER_PRACTICE_ENABLED=false

# --- Scheduling backend: where the agent reads and writes appointments
# none (default, phase 0): the agent converses and books nothing.
# practice: an in-memory schedule with fictitious businesses
# (src/voice_call_agent/practice_schedule/practice_businesses.toml), lost on restart; needs
# ENVIRONMENT=development. A browser practice call reaches its default business.
SCHEDULING_BACKEND=none

# --- HTTP hardening
# production (default): HSTS on, /docs, /redoc and /openapi.json off. development: the opposite.
ENVIRONMENT=production
# Host header values the service answers to (comma-separated). The host of PUBLIC_BASE_URL is
# added automatically; list the public host here when only WhatsApp is enabled.
ALLOWED_HOSTS=localhost,127.0.0.1
# Proxies whose X-Forwarded-* headers are trusted (comma-separated addresses, or * behind a
# private load balancer only). Client addresses for rate limiting come from these headers.
TRUSTED_PROXY_ADDRESSES=127.0.0.1
# CORS stays closed when empty: the service has no browser clients. Explicit origins only,
# comma-separated; '*' is rejected at startup.
CORS_ALLOWED_ORIGINS=
# Largest HTTP request body accepted (413 beyond it), in bytes.
MAX_REQUEST_BODY_BYTES=65536
# Largest WebSocket message accepted on the Media Stream, in bytes.
MAX_WEBSOCKET_MESSAGE_BYTES=65536

# --- Webhook protection
# Per client address and route, on the call entries (limits syntax: N/second|minute|hour).
WEBHOOK_RATE_LIMIT=60/minute
# async+memory:// keeps counters per instance; use a shared store (async+redis://host:6379)
# when several instances run.
RATE_LIMIT_STORAGE_URI=async+memory://
# How long webhook event ids are remembered to reject repeats, in seconds.
REPLAY_WINDOW_SECONDS=300
# Older WhatsApp `connect` events are dropped: Meta allows ~30-60 s to accept a call.
META_CONNECT_MAX_AGE_SECONDS=60

# --- Concurrency and shutdown (per instance)
MAX_CONCURRENT_CALLS=10
# How long a shutdown waits for calls in progress before cutting them, in seconds.
# The orchestrator's termination grace period must be longer.
SHUTDOWN_GRACE_SECONDS=300

# --- Observability
# One JSON line per call: latency per segment, errors, versions, usage and estimated cost.
CALL_TRACE_LOG_PATH=var/call_traces.jsonl
# Error tracking and per-call traces (Sentry project `voice-call-agent`). Empty: disabled.
# The DSN comes only from the environment, never from a committed file.
SENTRY_DSN=
# Share of calls sent as Sentry transactions (0..1).
SENTRY_TRACES_SAMPLE_RATE=1.0
# INFO or higher in production: Pipecat logs conversation content at DEBUG.
LOG_LEVEL=INFO
# json (default) | text
LOG_FORMAT=json
